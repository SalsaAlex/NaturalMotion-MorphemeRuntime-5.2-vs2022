##END-LALR-STATES
    {0, NULL}
  };
##END-LALR-TABLE


  // --------------------------------------------------------------------
  // 
  // --------------------------------------------------------------------

  const Grammar Parser::sGrammar = 
  {
    CASESENTITIVEHERE%CaseSensitive%,
	STARTSYMBOLHERE%StartSymbol%,
##DFA-TABLE
    %InitialState%,
##END-DFA-TABLE
##LALR-TABLE
    %InitialState%,
##END-LALR-TABLE

##SYMBOL-TABLE
    %Count%, SymbolArray,
##END-SYMBOL-TABLE
##RULE-TABLE
