		{%SymbolIndex%, Action::Op(%Action%), %Value%}, // Action Name here
##END-LALR-ACTIONS
		{-1, Action::INVALID, -1}
	};
##END-LALR-STATES
##END-LALR-TABLE

  // --------------------------------------------------------------------
