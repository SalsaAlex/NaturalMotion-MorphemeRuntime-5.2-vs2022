  // --------------------------------------------------------------------
  
##DFA-TABLE
  const DFAState DFAStateArray[%Count%+1] = 
  {
##DFA-STATES
    /* %Index% */   {%AcceptIndex%, %EdgeCount%, DFAEdgeArray%Index%},
##END-DFA-STATES
    {-1, 0, NULL}
  };
##END-DFA-TABLE



  // --------------------------------------------------------------------
  // Rule Table
  //                        head, symbol count, symbol array, description
  // --------------------------------------------------------------------

##RULE-TABLE
  const Rule RuleArray[%Count%] = 
  {
##RULES
    /* %Index% */   {%NonterminalIndex%, %SymbolCount%, RuleSymbolArray%Index%, "%Description%"},
##END-RULES
  };
##END-RULE-TABLE


  // --------------------------------------------------------------------
